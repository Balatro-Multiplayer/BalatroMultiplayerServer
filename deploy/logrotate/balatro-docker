# Time-based rotation, compression and retention for Docker container logs.
#
# Docker's json-file logging driver only rotates by SIZE (max-size/max-file) and
# never compresses or expires by age. This logrotate config adds the time-based
# behavior we want for the relay's stdout/stderr:
#
#   - rotate daily
#   - compress rotated logs after 1 day  (compress + delaycompress: the most
#     recent rotation stays uncompressed for quick grepping, older ones gzip)
#   - keep ~30 days, then delete         (rotate 30, with daily rotation)
#
# copytruncate is required because the json-file driver holds the log file open
# and offers no reopen signal, so we copy-then-truncate in place. (Trade-off: a
# tiny race on truncate can drop a few in-flight lines, and very chatty bursts
# can briefly produce a sparse file. Acceptable for relay logs.)
#
# Install: copy to /etc/logrotate.d/balatro-docker on the host (root:root, 0644).
# logrotate runs daily via /etc/cron.daily/logrotate, so no extra timer needed.
# This is the SOLE rotator for these files — leave the compose `logging:` driver
# without max-size/max-file so Docker doesn't also rotate them and collide.

/var/lib/docker/containers/*/*-json.log {
    daily
    rotate 30
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
}
