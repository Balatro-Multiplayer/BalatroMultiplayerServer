# Copy to apps/discord-bot/.env. See README.md. Any required value missing =
# the bot logs one "disabled" line and idles until restarted.

# Discord Developer Portal > your application.
DISCORD_BOT_TOKEN=
DISCORD_BOT_CLIENT_ID=
# The server (guild) whose roles the bot manages.
DISCORD_GUILD_ID=

# Same value as DISCORD_BOT_API_KEY in apps/server/.env.
DISCORD_BOT_API_KEY=

# One Discord role id per managed role (Server Settings > Roles > right-click
# > Copy Role ID, with Developer Mode on).
DISCORD_ROLE_STONE=
DISCORD_ROLE_STEEL=
DISCORD_ROLE_GOLD=
DISCORD_ROLE_LUCKY=
DISCORD_ROLE_GLASS=
DISCORD_ROLE_FOIL=
DISCORD_ROLE_HOLOGRAPHIC=
DISCORD_ROLE_POLYCHROME=
DISCORD_ROLE_NEGATIVE=

# Optional.
#SYNC_INTERVAL_MINUTES=10
# On unless false: logs planned changes without making them.
#DRY_RUN=true
