{
	"_comment": "Shared by the server (src/tests/mods/mod-layouts.test.ts) and the launcher's parity check. Each case is an extracted archive's file tree; expectedRoot is the folder the canonical flatten must pick ('' = the archive root itself), expectedHash the folder hash of the result. layout 'thunderstore' is never flattened. Change these only together with both implementations -- see new-launcher THUNDERSTORE_MIGRATION_PLAN.md section 4.",
	"cases": [
		{
			"name": "handy-release-asset-decoy",
			"layout": "github",
			"files": {
				"lovely.toml": "[manifest]\nversion = \"1.0.0\"\npriority = 99999999\n\n[[patches]]\n[patches.pattern]\ntarget = \"game.lua\"\npattern = '''boot_timer('splash prep', 'end',1)'''\nposition = \"after\"\npayload = '''\nif not Handy then\n    error([[Handy mod installed incorrectly. No \"folder in folder\" like \"/Mods/HandyBalatro/HandyBalatro\"]])\nend\n'''\n",
				"Put HandyBalatro folder you see here in Mods folder.txt": "",
				"toml file you see here will crash your game. Just follow instructions.txt": "",
				"HandyBalatro/.gitignore": "*.log\n",
				"HandyBalatro/metadata.json": "{\n\t\"id\": \"Handy\",\n\t\"name\": \"Handy\",\n\t\"main_file\": \"steamodded.lua\",\n\t\"version\": \"2.0.6\"\n}\n",
				"HandyBalatro/manifest.json": "{\n\t\"name\": \"Handy\",\n\t\"version_number\": \"2.0.6\",\n\t\"dependencies\": [\"Thunderstore-lovely-0.9.0\"]\n}\n",
				"HandyBalatro/steamodded.lua": "Handy.steamodded = true\n",
				"HandyBalatro/index.lua": "Handy = {}\n",
				"HandyBalatro/lovely/index.toml": "[manifest]\nversion = \"1.0.0\"\n\n[[patches]]\n[patches.module]\nsource = 'src/libs/json.lua'\nbefore = 'main.lua'\nname = 'handy/json'\n",
				"HandyBalatro/src/libs/json.lua": "return {}\n"
			},
			"expectedRoot": "HandyBalatro",
			"expectedHash": "d9235ddf9176dc12937353af1e4217b650797cf434add849011af1abe928b6e6"
		},
