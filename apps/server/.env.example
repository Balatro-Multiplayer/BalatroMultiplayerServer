PORT=8788
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bmp

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h

# Steam
STEAM_WEB_API_KEY=your-steam-web-api-key
STEAM_APP_ID=2379780

# Discord OAuth2
DISCORD_CLIENT_ID=your-discord-app-client-id
DISCORD_CLIENT_SECRET=your-discord-app-client-secret
DISCORD_REDIRECT_URI=https://new.balatromp.com/api/auth/discord/callback

# EMQX
EMQX_BROKER_URL=mqtt://emqx:1883
EMQX_SYSTEM_CLIENT_ID=bmp-api-server
EMQX_SYSTEM_USERNAME=bmp-system
EMQX_SYSTEM_PASSWORD=change-me-in-production

# Player identity (used to hash Steam/Discord IDs before storage — never expose or rotate this)
PLAYER_ID_SALT=change-me-use-at-least-32-random-chars

# Admin endpoint secret (POST /admin/refresh-config)
ADMIN_SECRET=change-me-use-at-least-32-random-chars

# Flags
TESTING_MODE=false
# chatEnabled/rankedEnabled/casualQueueEnabled/lobbyCreationEnabled are now
# DB-backed (server_config table), admin-editable at /admin/config -- see
# migration 0036_server_config_feature_flags.sql.

# Dev-only (forced off outside NODE_ENV=development regardless of this value):
# marks every connecting player launcher-verified without ever issuing a
# challenge, for local Ranked testing with clients that have no real BET
# launcher to answer one (e.g. ClaudeControl). Off by default.
DEV_AUTO_VERIFY_LAUNCHER=false

# Mod catalog sync (hourly job, features/mods/mods-sync.service.ts) -- pulls
# skyline69/balatro-mod-index directly (whole-repo zip, no GitHub API/token
# needed for that part). Off by default; set to true to enable.
MOD_INDEX_SYNC_ENABLED=false

# Thunderstore half of the same sync (features/mods/thunderstore-mod-index.service.ts)
# -- pulls thunderstore.io/c/balatro's package list directly (one unauthenticated
# request, no token needed). Independent of MOD_INDEX_SYNC_ENABLED above. Off
# by default; set to true to enable.
THUNDERSTORE_SYNC_ENABLED=false

# Optional for the handful of api.github.com calls made to auto-check
# versions of admin-created "custom" mods (see mod_registry.automatic_version_check)
# - just raises the unauthenticated 60/hr GitHub REST rate limit there.
# Effectively REQUIRED for the launcher-releases admin feature though (see
# features/launcher-releases/launcher-github-releases.service.ts), which
# reads and proxy-downloads Releases from the PRIVATE
# Balatro-Multiplayer/new-launcher repo - needs a real token with repo
# (classic) or Contents:Read (fine-grained) access to that repo specifically,
# or every launcher-release admin action and public download fails.
GITHUB_TOKEN=

# Launcher-integrity challenge secret -- only read by the PRIVATE
# BalatroMultiplayerServerInternal package (overlaid onto packages/internal at
# deploy time, see that repo's README), not by this repo directly. Listed
# here for deploy convenience only.
LAUNCHER_INTEGRITY_SECRET=change-me-use-at-least-32-random-chars

# Directory of archived Discord channel bundles (features/webadmin/archives.route.ts),
# each produced externally by the discord-channel-archiver bot and manually
# copied onto the server -- this app only reads here, never writes. In Docker
# this is the container-internal mount point (see docker-compose.yml's
# api-blue volumes:, which binds the real host directory here read-only);
# defaults to a relative path for running the server directly outside Docker.
ARCHIVE_DIR=./archives