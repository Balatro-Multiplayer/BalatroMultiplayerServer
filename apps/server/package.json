{
	"name": "balatro-multiplayer-api-server",
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"build": "tsc",
		"dev": "tsx watch src/main.ts",
		"start": "node dist/main.js",
		"migrate": "tsx src/infrastructure/db/migrate.ts",
		"generate": "drizzle-kit generate",
		"backfill-mod-hashes": "tsx src/features/mods/backfill-mod-hashes.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "vitest run --config vitest.e2e.config.ts",
		"lint": "biome check .",
		"format": "biome format --write ."
	},
	"dependencies": {
		"@bmp/types": "workspace:*",
		"@v-rtualized/bmp-internal": "workspace:*",
		"adm-zip": "^0.5.16",
		"drizzle-orm": "^0.38.0",
		"express": "^5.0.0",
		"express-rate-limit": "^8.2.1",
		"jsonwebtoken": "^9.0.0",
		"mqtt": "^5.10.0",
		"multer": "^2.2.0",
		"obscenity": "^0.4.6",
		"pg": "^8.13.0",
		"sanitize-html": "^2.17.7"
	},
	"devDependencies": {
		"@biomejs/biome": "*",
		"@types/adm-zip": "^0.5.5",
		"@types/express": "^5.0.0",
		"@types/jsonwebtoken": "^9.0.0",
		"@types/multer": "^2.2.0",
		"@types/node": "^22.0.0",
		"@types/pg": "^8.11.0",
		"@types/sanitize-html": "^2.16.1",
		"@types/supertest": "^6.0.0",
		"drizzle-kit": "^0.30.0",
		"supertest": "^7.0.0",
		"tsx": "^4.19.0",
		"typescript": "^5.7.0",
		"vitest": "^3.0.0"
	}
}
