# Placeholder file for local dev only. docker-compose.yml's base nginx
# service mounts real TLS cert/key files from bmpserver's host filesystem;
# those paths don't exist on a local dev machine. docker-compose.local.yml
# mounts this file at both targets instead -- nginx/local/server.conf has
# no `ssl_certificate`/`ssl_certificate_key` directives at all, so the
# content here is never read. It only needs to exist so the bind mount
# itself succeeds.
