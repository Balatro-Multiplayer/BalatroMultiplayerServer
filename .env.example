# Settings for compose.local.yml (a Community or Dev server). Copy to .env in
# this folder; Docker Compose reads it. Every line is optional: an unset key
# uses the public placeholder in compose.local.yml. No Steam Web API key is
# needed. The Official server (docker-compose.yml) does not use this file.

# --- Dev server --------------------------------------------------------------
# Uncomment both for a Dev server: the API, the website, the Nakama bundle
# rebuilding on save, and every dev flag allowed. Then:
#   docker compose -f compose.local.yml up --watch
#BMP_SERVER_KIND=dev
#COMPOSE_PROFILES=dev
# Optional dev flags (Dev server only):
#DEV_AUTO_VERIFY_LAUNCHER=true
#DEV_FAKE_LAUNCHER_STRATEGY=true
#LOBBY_GRACE_SECONDS=
#RESULT_TIMEOUT_SECONDS=

# --- Community server --------------------------------------------------------
# community (the default) or dev.
#BMP_SERVER_KIND=community
# Extra services: api, web (needs api, starts it), moderation. Comma-separated.
#COMPOSE_PROFILES=api,web

# Let other machines reach Nakama (port 7350). Before you do, replace every
# placeholder key below with your own random value.
#NAKAMA_BIND_ADDRESS=0.0.0.0
#NAKAMA_HTTP_KEY=
#NAKAMA_SESSION_KEY=
#NAKAMA_REFRESH_KEY=
#NAKAMA_CONSOLE_PASSWORD=
#NAKAMA_CONSOLE_SIGNING_KEY=
#INTERNAL_API_KEY=
#JWT_SECRET=
#ADMIN_SECRET=
# Hashes stored Steam and Discord ids. Set it once; never change it after.
#PLAYER_ID_SALT=
# Hashes the networks players log in from (network bans, Official server
# only). Set it once; never change it after.
#IP_HASH_SALT=
# The address players open the website at (login links use it).
#WEB_BASE_URL=http://127.0.0.1:3000

# Chat: unset uses the local word filter. "on" uses the moderation profile's
# model (put the model in place first, see apps/moderation/README.md).
#MODERATION_REMOTE=on
